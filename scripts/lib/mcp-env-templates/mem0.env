# MCP env template for the mem0 stdio server.
# Resolved at spawn-time via: op run --env-file <this-file> -- <command>
# Only list secrets this server needs; non-secret vars are inherited
# from the process env (Claude Code passes them through by default).
#
# op:// refs are resolved by `op run` using OP_SERVICE_ACCOUNT_TOKEN
# from the parent shell env at spawn time.
MEM0_API_KEY=op://COO/mem0-api-vade-coo/credential
