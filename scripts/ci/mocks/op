#!/usr/bin/env bash
# Mock 1Password CLI for the bootstrap-regression suite (issue #86).
#
# Returns canned vade-coo-shaped responses for the subset of `op` calls
# made by scripts/boot/coo-bootstrap.sh (whoami + read of the four COO refs).
# SSH key material is read from $VADE_CI_MOCK_KEYDIR/vade-coo-{auth,sign}{,.pub};
# the runner generates fresh ed25519 keys per CI invocation and exports
# their fingerprints as COO_AUTH_FP_EXPECTED / COO_SIGN_FP_EXPECTED so
# install_coo_ssh_keys' fingerprint check passes.
#
# Real op CLI is never installed in the regression job — ensure_op_cli's
# `check_cmd op` short-circuits because this mock is on PATH first
# (VADE_BINDIR_OVERRIDE points at the dir holding this binary).
#
# Out-of-scope subcommands print a clear "[mock op]" diagnostic and exit
# non-zero, so a bootstrap change that calls a new op subcommand fails
# the regression visibly rather than silently passing.
set -euo pipefail

KEYDIR="${VADE_CI_MOCK_KEYDIR:-/tmp/vade-ci-mocks/keys}"

case "${1:-}" in
  --version)
    echo "2.31.0 (vade-ci mock)"
    exit 0
    ;;
  whoami)
    # Track 4 Phase 1: support --format=json for SA identity check.
    # Returns op 2.31+ live schema (url/URL/user_uuid/account_uuid/user_type/
    # ServiceAccountType) so the CI mock matches the production CLI shape;
    # `ServiceAccount` is kept in parallel so forward-compat across CLI
    # versions stays exercised in CI.
    case "${2:-}" in
      --format=json|--format)
        printf '{"url":"https://ci.mock","URL":"https://ci.mock","user_uuid":"CIMOCKCIMOCKCIMOCKCIMOCKCI","account_uuid":"CIMOCKACCOUNTCIMOCKACCOUNTC","user_type":"SERVICE_ACCOUNT","ServiceAccountType":"SERVICE_ACCOUNT","ServiceAccount":"ci-mock-coo-bootstrap"}\n'
        ;;
      *)
        echo "ServiceAccount: ci-mock-coo-bootstrap"
        ;;
    esac
    exit 0
    ;;
  read)
    ref="${2:-}"
    case "$ref" in
      "op://COO/github-pat-vade-coo/token")
        echo "ghp_CIMOCK00000000000000000000000000000000"
        ;;
      "op://COO/github-pat-classic-public/credential")
        # Mocked cross-org public-repo PAT (MEMO-2026-05-11-6xv2). Classic
        # `ghp_` prefix; placeholder body so disk content scanners don't
        # match a real-shape token.
        echo "ghp_CIMOCK_PUBLIC_PAT_DO_NOT_USE_000000"
        ;;
      "op://COO/agentmail-api-vade-coo/credential")
        echo "am_CIMOCK_AGENTMAIL_KEY_DO_NOT_USE"
        ;;
      "op://COO/mem0-api-vade-coo/credential")
        echo "m0_CIMOCK_MEM0_KEY_DO_NOT_USE"
        ;;
      "op://COO/r2-transcripts/access-key-id")
        # Mocked R2 access key id. Shape note: real Cloudflare R2 issues
        # 32-char lowercase hex; mock returns a non-shape placeholder so
        # the literal-shape regex (a-f0-9) doesn't match anything in
        # disk content scanners.
        echo "R2AKID_CIMOCK_DO_NOT_USE_R2AKID_CI"
        ;;
      "op://COO/r2-transcripts/secret-access-key")
        echo "R2SECRET_CIMOCK_DO_NOT_USE_R2SECRET_CIMOCK_DO_NOT_USE_R2SECRET_CIMK"
        ;;
      "op://COO/transcripts-age-key/credential")
        # Mocked age identity. The literal `AGE-SECRET-KEY-1` prefix
        # is necessary for an end-to-end test; body is `CIMOCK0...` ASCII
        # and never decrypts a real ciphertext.
        echo "AGE-SECRET-KEY-1CIMOCK000000000000000000000000000000000000000000000000"
        ;;
      "op://COO/vade-canvas-bearer-coo/credential")
        # Mocked vade-canvas MCP bearer (vade-core#93). Real value is the
        # operator-shaped opaque bearer that vade-canvas MCP accepts via
        # Fly's VADE_AUTH_TOKENS.agents[]; mock returns a non-shape
        # placeholder so the CI integrity-check passes without a real
        # canvas roundtrip.
        echo "vat_CIMOCK_VADE_AUTH_TOKEN_DO_NOT_USE"
        ;;
      "op://COO/vade-coo-ssh-auth/private key")
        cat "$KEYDIR/vade-coo-auth"
        ;;
      "op://COO/vade-coo-ssh-auth/public key")
        cat "$KEYDIR/vade-coo-auth.pub"
        ;;
      "op://COO/vade-coo-ssh-sign/private key")
        cat "$KEYDIR/vade-coo-sign"
        ;;
      "op://COO/vade-coo-ssh-sign/public key")
        cat "$KEYDIR/vade-coo-sign.pub"
        ;;
      "op://COO/cloudflare-api-vade-coo/account_id")
        # Mocked Cloudflare account ID (non-secret public identifier).
        echo "0000000000000000000000000000cimock"
        ;;
      "op://COO/github-app-vade-coo/app_id")
        # GitHub App ID (vade-coo-memory#837) — canned numeric for the
        # CI mode. Real value is set in production via Ven's UI work
        # (Phase 1) and stored in op://COO/github-app-vade-coo/app_id.
        echo "999000"
        ;;
      "op://COO/github-app-vade-coo/installation_id")
        echo "888777"
        ;;
      "op://COO/github-app-vade-coo/private_key")
        # Placeholder PEM-shaped string for CI. fetch_coo_secrets only
        # checks for non-empty; the minter (gh-app-token.sh) is not on
        # the bootstrap-regression hot path, so this body is never
        # parsed by openssl in CI. Production reads the real key from
        # 1Password on demand at mint time.
        echo "-----BEGIN RSA PRIVATE KEY----- CIMOCK00000000000000000000= -----END RSA PRIVATE KEY-----"
        ;;
      *)
        echo "[mock op] unknown op:// ref: $ref" >&2
        exit 2
        ;;
    esac
    exit 0
    ;;
  run)
    # Phase 2 (coo-memory#873): MCP children spawn via `op run --env-file`.
    # In CI the real `op run` would resolve op:// refs and inject them; the
    # mock parses the --env-file, resolves each line's op:// ref via our
    # `op read` mock, exports the result, and execs the trailing command.
    # This keeps CI end-to-end without a real 1Password connection.
    shift  # drop "run"
    ENV_FILE=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --env-file)
          ENV_FILE="$2"; shift 2 ;;
        --env-file=*)
          ENV_FILE="${1#--env-file=}"; shift ;;
        --)
          shift; break ;;
        --no-masking)
          shift ;;
        *)
          break ;;
      esac
    done
    if [ -n "$ENV_FILE" ] && [ -f "$ENV_FILE" ]; then
      while IFS='=' read -r var_name var_ref || [ -n "$var_name" ]; do
        # Skip comment lines and blank lines
        case "$var_name" in
          '#'*|'') continue ;;
        esac
        # Trim leading whitespace
        var_name="${var_name#"${var_name%%[! ]*}"}"
        # Only handle op:// refs; plain values pass through as-is
        case "$var_ref" in
          op://*)
            val="$(bash "$0" read "$var_ref" 2>/dev/null || true)"
            if [ -n "$val" ]; then
              export "$var_name=$val"
            fi
            ;;
          *)
            # Plain value (no op:// ref) — export as-is if non-empty
            [ -n "$var_ref" ] && export "$var_name=$var_ref"
            ;;
        esac
      done < "$ENV_FILE"
    fi
    exec "$@"
    ;;
  *)
    echo "[mock op] unhandled subcommand: $*" >&2
    exit 2
    ;;
esac
