{
  "mcpServers": {
    "mem0": {
      "type": "stdio",
      "command": "/home/user/.local/bin/op",
      "args": [
        "run",
        "--env-file",
        "/dev/shm/coo-mcp-env/mem0.env",
        "--",
        "/home/user/coo-harness/scripts/mcp/mem0-mcp-projection.py"
      ],
      "env": {
        "MEM0_DEFAULT_USER_ID": "ven"
      }
    },
    "agentmail": {
      "command": "/home/user/.local/bin/op",
      "args": [
        "run",
        "--env-file",
        "/dev/shm/coo-mcp-env/agentmail.env",
        "--",
        "npx",
        "-y",
        "agentmail-mcp"
      ]
    },
    "1password": {
      "command": "npx",
      "args": [
        "-y",
        "@takescake/1password-mcp@2.4.2"
      ],
      "env": {
        "OP_SERVICE_ACCOUNT_TOKEN": "${OP_SERVICE_ACCOUNT_TOKEN}"
      }
    }
  }
}
