{
  "model": "opusplan",
  "effortLevel": "high",
  "showThinkingSummaries": true,
  "alwaysThinkingEnabled": true,
  "outputStyle": "coo",
  "includeGitInstructions": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/boot/boot-brake-clear.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/boot/session-start-sync.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/boot/coo-bootstrap.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_COO_MEMORY_DIR/.claude/_lib/memo-index.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/boot/boot-brake-clear.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/lifecycle/session-lifecycle.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/lifecycle/session-end-transcript-export.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/lifecycle/session-end-transcript-render.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/lifecycle/session-lifecycle.sh\" --end"
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/persist-permissions.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/boot-brake-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/bash-token-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/bash-github-api-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/strip-bash-xtrace.sh\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/agent-model-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/preuse-agent-env-scrub.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/skill-yaml-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/workflow-file-auth-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/skill-best-practices-nudge.sh\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/read-boot-inlined-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/auto-subscribe-pr.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/git-push-workflow-scope-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$VADE_RUNTIME_DIR/scripts/hooks/postuse-bash-redactor.sh\""
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "VADE_BRAKE_ENFORCE": "block-on-FAIL",
    "GIT_AUTHOR_NAME": "COO",
    "GIT_AUTHOR_EMAIL": "coo@vade-app.dev",
    "GIT_COMMITTER_NAME": "COO",
    "GIT_COMMITTER_EMAIL": "coo@vade-app.dev"
  },
  "skillOverrides": {
    "agentmail": "user-invocable-only"
  },
